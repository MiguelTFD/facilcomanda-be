# Copia este archivo como ".env" en el VPS (NO lo subas nunca a git; .env ya está en .gitignore)
#
# Despliegue con BD propia en el VPS (docker-compose.prod.yml):
#   - DB_HOST y DB_PORT los fija el compose (db:5432); estos valores se usan
#     para crear el contenedor de PostgreSQL y para que el backend se conecte.
#   - Genera DB_PASSWORD y JWT_SECRET con: openssl rand -hex 32

DB_HOST=db
DB_PORT=5432
DB_NAME=facilcomanda
DB_USER=facilcomanda
DB_PASSWORD=
JWT_SECRET=
